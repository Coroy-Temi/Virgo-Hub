@page "/students"
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@inject VirgoHubService Hub

<PageTitle>VirgoHub Students</PageTitle>

@if (!hasAccess)
{
    <section class="surface-card">
        <div class="empty-state-vgh">
            <strong>Access restricted</strong>
            <span>Your portal account does not have permission to manage student records.</span>
        </div>
    </section>
}
else
{
<section class="page-intro">
    <div>
        <div class="section-kicker">Student Access</div>
        <h2>Manage student records and porter access.</h2>
        <p>Create profiles, update student details, and remove records from one place.</p>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(feedback))
{
    <div class="toast-banner @feedbackType">@feedback</div>
}

<section class="dashboard-grid">
    <div class="surface-card">
        <div class="surface-head">
            <h3>Create student profile</h3>
        </div>
        <div class="form-grid-vgh">
            <label><span>Full name</span><InputText @bind-Value="student.FullName" /></label>
            <label><span>School email</span><InputText @bind-Value="student.Email" /></label>
            <label><span>Level</span><InputText @bind-Value="student.Level" /></label>
            <label><span>Department</span><InputText @bind-Value="student.Department" /></label>
            <label><span>Faculty</span><InputText @bind-Value="student.Faculty" /></label>
            <label><span>Matric number</span><InputText @bind-Value="student.MatricNumber" /></label>
            <label><span>Hostel</span><InputText @bind-Value="student.Hostel" /></label>
            <label>
                <span>Gender</span>
                <InputSelect @bind-Value="student.Gender">
                    @foreach (var gender in Enum.GetValues<UserGender>())
                    {
                        <option value="@gender">@gender</option>
                    }
                </InputSelect>
            </label>
            <label><span>Sports director access</span><InputCheckbox @bind-Value="student.IsSportsDirector" /></label>
        </div>
        <button class="vgh-button" @onclick="SaveStudentAsync">Activate student</button>
    </div>

    @if (isSuperAdmin)
    {
    <div class="surface-card">
        <div class="surface-head">
            <h3>Create porter access</h3>
        </div>
        <div class="form-grid-vgh">
            <label><span>Porter full name</span><InputText @bind-Value="porter.FullName" /></label>
            <label><span>Staff ID</span><InputText @bind-Value="porter.StaffId" /></label>
            <label><span>Temporary password</span><InputText @bind-Value="porter.Password" type="password" /></label>
            <label>
                <span>Complaint scope</span>
                <InputSelect @bind-Value="porter.Gender">
                    <option value="@UserGender.Male">Male hostels</option>
                    <option value="@UserGender.Female">Female hostels</option>
                </InputSelect>
            </label>
        </div>
        <button class="vgh-button alt" @onclick="SavePorterAsync">Create porter login</button>
    </div>
    }
</section>

<section class="dashboard-grid">
    <div class="surface-card">
        <div class="surface-head">
            <h3>Edit student profile</h3>
        </div>
        <div class="form-grid-vgh">
            <label class="full-span">
                <span>Select student</span>
                <InputSelect @bind-Value="selectedStudentId">
                    <option value="">Choose a student</option>
                    @foreach (var item in students)
                    {
                        <option value="@item.Id">@item.FullName - @item.Email</option>
                    }
                </InputSelect>
            </label>
        </div>
        <div style="margin-top: 0.9rem; display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <button class="vgh-button alt" @onclick="LoadStudentEditor">Load profile</button>
            @if (selectedStudent is not null)
            {
                <button class="vgh-button" @onclick="UpdateStudentAsync">Save changes</button>
                <button class="vgh-button alt" @onclick="DeleteStudentAsync">Remove student</button>
            }
        </div>

        @if (selectedStudent is not null)
        {
            <div class="form-grid-vgh" style="margin-top: 1rem;">
                <label><span>Full name</span><InputText @bind-Value="studentEditor.FullName" /></label>
                <label><span>School email</span><InputText @bind-Value="studentEditor.Email" /></label>
                <label><span>Level</span><InputText @bind-Value="studentEditor.Level" /></label>
                <label><span>Department</span><InputText @bind-Value="studentEditor.Department" /></label>
                <label><span>Faculty</span><InputText @bind-Value="studentEditor.Faculty" /></label>
                <label><span>Matric number</span><InputText @bind-Value="studentEditor.MatricNumber" /></label>
                <label><span>Hostel</span><InputText @bind-Value="studentEditor.Hostel" /></label>
                <label>
                    <span>Gender</span>
                    <InputSelect @bind-Value="studentEditor.Gender">
                        @foreach (var gender in Enum.GetValues<UserGender>())
                        {
                            <option value="@gender">@gender</option>
                        }
                    </InputSelect>
                </label>
                <label><span>Sports director access</span><InputCheckbox @bind-Value="studentEditor.IsSportsDirector" /></label>
            </div>
        }
    </div>

    @if (isSuperAdmin)
    {
    <div class="surface-card">
        <div class="surface-head">
            <h3>Porter access registry</h3>
            <span>@porters.Count porters</span>
        </div>
        <div class="table-shell">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Staff ID</th>
                        <th>Scope</th>
                        <th>Department</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in porters)
                    {
                        <tr>
                            <td>@item.FullName</td>
                            <td>@item.StaffId</td>
                            <td>@item.Gender</td>
                            <td>@item.Department</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    }
</section>

<section class="surface-card">
    <div class="surface-head">
        <h3>Student directory</h3>
        <span>@students.Count students</span>
    </div>
    <div class="table-shell">
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Department</th>
                    <th>Level</th>
                    <th>Sports</th>
                    <th>Hostel</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in students)
                {
                    <tr>
                        <td>@item.FullName</td>
                        <td>@item.Email</td>
                        <td>@item.Department</td>
                        <td>@item.Level</td>
                        <td>@(item.IsSportsDirector ? "Director" : "Student")</td>
                        <td>@item.Hostel</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private RegisterUserRequest student = new() { Role = UserRole.Student, Gender = UserGender.Male };
    private RegisterPorterRequest porter = new() { Gender = UserGender.Male };
    private UpdateUserRequest studentEditor = new() { Gender = UserGender.Male };
    private List<UserProfile> students = [];
    private List<UserProfile> porters = [];
    private UserProfile? currentUser;
    private UserProfile? selectedStudent;
    private string selectedStudentId = string.Empty;
    private string feedback = string.Empty;
    private string feedbackType = "ok";
    private bool hasAccess;
    private bool isSuperAdmin;

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is null)
        {
            return;
        }

        var authState = await AuthenticationStateTask;
        var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        currentUser = string.IsNullOrWhiteSpace(userId) ? null : Hub.GetUserById(userId);
        isSuperAdmin = currentUser?.Role == UserRole.SuperAdmin;
        hasAccess = currentUser is not null && (isSuperAdmin || Hub.CanAccessModule(currentUser.Id, AdminModule.Students));

        if (hasAccess)
        {
            Reload();
        }
    }

    private async Task SaveStudentAsync()
    {
        try
        {
            await Hub.RegisterUserAsync(student, currentUser?.Id);
            feedback = "Student access has been activated.";
            feedbackType = "ok";
            student = new RegisterUserRequest { Role = UserRole.Student, Gender = UserGender.Male };
            Reload();
        }
        catch (Exception ex)
        {
            feedback = ex.Message;
            feedbackType = "error";
        }
    }

    private async Task SavePorterAsync()
    {
        try
        {
            await Hub.RegisterPorterAsync(porter, currentUser?.Id);
            feedback = $"Porter access has been created for {porter.StaffId}.";
            feedbackType = "ok";
            porter = new RegisterPorterRequest { Gender = UserGender.Male };
            Reload();
        }
        catch (Exception ex)
        {
            feedback = ex.Message;
            feedbackType = "error";
        }
    }

    private void LoadStudentEditor()
    {
        selectedStudent = students.FirstOrDefault(x => x.Id == selectedStudentId);
        if (selectedStudent is null)
        {
            feedback = "Select a student profile first.";
            feedbackType = "error";
            return;
        }

        studentEditor = new UpdateUserRequest
        {
            FullName = selectedStudent.FullName,
            Email = selectedStudent.Email,
            Level = selectedStudent.Level,
            Department = selectedStudent.Department,
            Faculty = selectedStudent.Faculty,
            MatricNumber = selectedStudent.MatricNumber,
            Hostel = selectedStudent.Hostel,
            Gender = selectedStudent.Gender,
            IsSportsDirector = selectedStudent.IsSportsDirector
        };
    }

    private async Task UpdateStudentAsync()
    {
        try
        {
            if (selectedStudent is null)
            {
                throw new InvalidOperationException("Load a student profile first.");
            }

            await Hub.UpdateStudentAsync(selectedStudent.Id, studentEditor, currentUser?.Id);
            feedback = "Student profile updated successfully.";
            feedbackType = "ok";
            Reload();
            LoadStudentEditor();
        }
        catch (Exception ex)
        {
            feedback = ex.Message;
            feedbackType = "error";
        }
    }

    private async Task DeleteStudentAsync()
    {
        try
        {
            if (selectedStudent is null)
            {
                throw new InvalidOperationException("Load a student profile first.");
            }

            await Hub.DeleteStudentAsync(selectedStudent.Id, currentUser?.Id);
            feedback = "Student profile removed.";
            feedbackType = "ok";
            selectedStudent = null;
            selectedStudentId = string.Empty;
            studentEditor = new UpdateUserRequest { Gender = UserGender.Male };
            Reload();
        }
        catch (Exception ex)
        {
            feedback = ex.Message;
            feedbackType = "error";
        }
    }

    private void Reload()
    {
        students = Hub.GetUsers(currentUser?.Id).Where(x => x.Role == UserRole.Student).ToList();
        porters = Hub.GetPorters(currentUser?.Id).ToList();
    }
}
