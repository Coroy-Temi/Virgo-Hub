<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:VirgoHub.Mobile.Controls"
             x:Class="VirgoHub.Mobile.PersonalGroupsPage"
             Title="Teaching Groups"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#F3F8FF, Dark=#07172C}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="18,16,18,24"
                                 Spacing="18">
                <Border Padding="18"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#102542}"
                        Stroke="{AppThemeBinding Light=#D8E8FF, Dark=#1A3B70}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Teaching Groups"
                               FontSize="26"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#0B2A56, Dark=White}" />
                        <Label Text="{Binding PageSummary}"
                               FontSize="13"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light=#5B78A2, Dark=#C8D9F0}" />

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="10">
                            <Border Grid.Column="0"
                                    Padding="14"
                                    BackgroundColor="{AppThemeBinding Light=#F5FAFF, Dark=#0B2249}"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Workspace Role"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#0B2A56, Dark=White}" />
                                    <Label Text="{Binding RoleSummary}"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light=#5B78A2, Dark=#C8D9F0}" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="1"
                                    Padding="14"
                                    BackgroundColor="{AppThemeBinding Light=#F5FAFF, Dark=#0B2249}"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Active Groups"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#0B2A56, Dark=White}" />
                                    <Label Text="{Binding Store.PersonalGroupSummary}"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light=#5B78A2, Dark=#C8D9F0}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="18"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#102542}"
                        Stroke="{AppThemeBinding Light=#D8E8FF, Dark=#1A3B70}"
                        IsVisible="{Binding Store.IsPersonalLecturer}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="26" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Create a Teaching Group"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#0B2A56, Dark=White}" />
                        <Label Text="Set up a lecturer-led group, then share the invite code with learners you want inside that cohort."
                               FontSize="13"
                               TextColor="{AppThemeBinding Light=#5B78A2, Dark=#C8D9F0}" />
                        <Entry Text="{Binding GroupTitle}"
                               Placeholder="Group title" />
                        <Entry Text="{Binding CourseCode}"
                               Placeholder="Course code, for example PVT 101" />
                        <Editor Text="{Binding GroupSummary}"
                                Placeholder="What is this group about?"
                                AutoSize="TextChanges"
                                MinimumHeightRequest="100" />
                        <Button Text="Create Teaching Group"
                                BackgroundColor="#25A9F5"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="24"
                                HeightRequest="54"
                                Clicked="OnCreateGroupClicked" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="18"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#102542}"
                        Stroke="{AppThemeBinding Light=#D8E8FF, Dark=#1A3B70}"
                        IsVisible="{Binding Store.IsPersonalLearner}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="26" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Join with an Invite Code"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#0B2A56, Dark=White}" />
                        <Label Text="Paste the code shared by your lecturer and VirgoHub will add this workspace to your personal study flow."
                               FontSize="13"
                               TextColor="{AppThemeBinding Light=#5B78A2, Dark=#C8D9F0}" />
                        <Entry Text="{Binding InviteCode}"
                               Placeholder="Enter invite code" />
                        <Button Text="Join Teaching Group"
                                BackgroundColor="#25A9F5"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="24"
                                HeightRequest="54"
                                Clicked="OnJoinGroupClicked" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="18"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#102542}"
                        Stroke="{AppThemeBinding Light=#D8E8FF, Dark=#1A3B70}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="26" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="10">
                            <Label Text="{Binding GroupListTitle}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#0B2A56, Dark=White}" />
                            <Button Grid.Column="1"
                                    Text="Refresh"
                                    Padding="16,8"
                                    BackgroundColor="{AppThemeBinding Light=#DCEBFF, Dark=#173E71}"
                                    TextColor="{AppThemeBinding Light=#0B2A56, Dark=White}"
                                    Clicked="OnRefreshClicked" />
                        </Grid>

                        <CollectionView ItemsSource="{Binding Store.PersonalGroups}"
                                        EmptyView="No teaching groups are active yet in this personal workspace.">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="14"
                                            Margin="0,0,0,10"
                                            BackgroundColor="{AppThemeBinding Light=#F5FAFF, Dark=#0B2249}"
                                            StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="20" />
                                        </Border.StrokeShape>
                                        <VerticalStackLayout Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="10">
                                                <VerticalStackLayout Spacing="3">
                                                    <Label Text="{Binding Title}"
                                                           FontSize="18"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light=#0B2A56, Dark=White}" />
                                                    <Label Text="{Binding CourseCode, StringFormat='{}Course: {0}'}"
                                                           FontSize="13"
                                                           TextColor="#25A9F5" />
                                                </VerticalStackLayout>
                                                <Border Grid.Column="1"
                                                        Padding="12,6"
                                                        BackgroundColor="{AppThemeBinding Light=#DFF3FF, Dark=#173E71}"
                                                        StrokeThickness="0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="16" />
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding Members.Count, StringFormat='{}{0} learner(s)'}"
                                                           FontSize="12"
                                                           TextColor="{AppThemeBinding Light=#0B2A56, Dark=White}" />
                                                </Border>
                                            </Grid>

                                            <Label Text="{Binding Summary}"
                                                   FontSize="13"
                                                   LineBreakMode="WordWrap"
                                                   TextColor="{AppThemeBinding Light=#5B78A2, Dark=#C8D9F0}" />

                                            <Grid ColumnDefinitions="*,Auto,Auto"
                                                  ColumnSpacing="10">
                                                <VerticalStackLayout Spacing="3">
                                                    <Label Text="{Binding LecturerName, StringFormat='{}Lecturer: {0}'}"
                                                           FontSize="13"
                                                           TextColor="{AppThemeBinding Light=#5B78A2, Dark=#C8D9F0}" />
                                                    <Label Text="{Binding InviteCode, StringFormat='{}Invite code: {0}'}"
                                                           FontSize="13"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light=#0B2A56, Dark=White}" />
                                                </VerticalStackLayout>
                                                <Button Grid.Column="1"
                                                        Text="Open Hub"
                                                        Padding="16,8"
                                                        BackgroundColor="{AppThemeBinding Light=#DCEBFF, Dark=#173E71}"
                                                        TextColor="{AppThemeBinding Light=#0B2A56, Dark=White}"
                                                        Clicked="OnOpenHubClicked" />
                                                <Button Grid.Column="2"
                                                        Text="Copy Code"
                                                        Padding="16,8"
                                                        BackgroundColor="#25A9F5"
                                                        TextColor="White"
                                                        Clicked="OnCopyCodeClicked" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <controls:PortalBottomNav Grid.Row="1"
                                  ActiveTab="Voting" />
    </Grid>
</ContentPage>
