<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:VirgoHub.Mobile.Controls"
             x:Class="VirgoHub.Mobile.EventsPage"
             Title="Plans"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#F3F7FF, Dark=#07172C}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="18,16,18,20"
                                 Spacing="18">
                <Border Padding="18"
                        IsVisible="{Binding Store.IsPersonalMode}"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#102542}"
                        Stroke="{AppThemeBinding Light=#D8E5FB, Dark=#1A3B70}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="26" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="12">
                            <Image Grid.Column="0"
                                   Source="{Binding HeaderIcon}"
                                   HeightRequest="50"
                                   WidthRequest="50" />
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="2">
                                <Label Text="{Binding HeaderTitle}"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#0B2A56, Dark=White}" />
                                <Label Text="{Binding HeaderSummary}"
                                       FontSize="13"
                                       LineBreakMode="WordWrap"
                                       TextColor="{AppThemeBinding Light=#5B78A2, Dark=#C8D9F0}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="18"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#102542}"
                        Stroke="{AppThemeBinding Light=#D8E5FB, Dark=#1A3B70}"
                        IsVisible="{Binding Store.IsPersonalLecturer}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="26" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Create Test or Exam"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#0B2A56, Dark=White}" />
                        <Label Text="Attach an assessment to one teaching group, set the correct answers, and let VirgoHub reveal each learner's result only after submission."
                               FontSize="13"
                               TextColor="{AppThemeBinding Light=#5B78A2, Dark=#C8D9F0}" />
                        <Picker Title="Teaching group"
                                ItemsSource="{Binding Store.PersonalGroups}"
                                ItemDisplayBinding="{Binding Title}"
                                SelectedItem="{Binding SelectedGroup}" />
                        <Entry Text="{Binding AssessmentTitle}"
                               Placeholder="Assessment title" />
                        <Editor Text="{Binding AssessmentSummary}"
                                Placeholder="What should learners know before they open this?"
                                AutoSize="TextChanges"
                                MinimumHeightRequest="90" />
                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="10">
                            <Picker Grid.Column="0"
                                    Title="Type"
                                    ItemsSource="{Binding AssessmentTypeOptions}"
                                    SelectedItem="{Binding SelectedAssessmentType}" />
                            <Entry Grid.Column="1"
                                   Keyboard="Numeric"
                                   Text="{Binding TimeLimitMinutes}"
                                   Placeholder="Time limit (minutes)" />
                        </Grid>

                        <Label Text="Questions"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#0B2A56, Dark=White}" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding QuestionDrafts}"
                                             Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="14"
                                            BackgroundColor="{AppThemeBinding Light=#F5FAFF, Dark=#0B2249}"
                                            StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="20" />
                                        </Border.StrokeShape>
                                        <VerticalStackLayout Spacing="10">
                                            <Label Text="{Binding Heading}"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#0B2A56, Dark=White}" />
                                            <Editor Text="{Binding Prompt}"
                                                    Placeholder="Question prompt"
                                                    AutoSize="TextChanges"
                                                    MinimumHeightRequest="70" />
                                            <Entry Text="{Binding OptionA}"
                                                   Placeholder="Option A" />
                                            <Entry Text="{Binding OptionB}"
                                                   Placeholder="Option B" />
                                            <Entry Text="{Binding OptionC}"
                                                   Placeholder="Option C" />
                                            <Entry Text="{Binding OptionD}"
                                                   Placeholder="Option D" />
                                            <Grid ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="10">
                                                <Picker Grid.Column="0"
                                                        Title="Correct option"
                                                        ItemsSource="{Binding CorrectOptionChoices}"
                                                        SelectedItem="{Binding CorrectOption}" />
                                                <Button Grid.Column="1"
                                                        Text="Remove"
                                                        BackgroundColor="#FFE8E6"
                                                        TextColor="#B42318"
                                                        Clicked="OnRemoveQuestionClicked" />
                                            </Grid>
                                            <Editor Text="{Binding Explanation}"
                                                    Placeholder="Explanation learners will see after submission"
                                                    AutoSize="TextChanges"
                                                    MinimumHeightRequest="60" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="10">
                            <Button Grid.Column="0"
                                    Text="Add Question"
                                    BackgroundColor="{AppThemeBinding Light=#DCEBFF, Dark=#173E71}"
                                    TextColor="{AppThemeBinding Light=#0B2A56, Dark=White}"
                                    Clicked="OnAddQuestionClicked" />
                            <Button Grid.Column="1"
                                    Text="Publish Assessment"
                                    BackgroundColor="#25A9F5"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    Clicked="OnCreateAssessmentClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="18"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#102542}"
                        Stroke="{AppThemeBinding Light=#D8E5FB, Dark=#1A3B70}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="26" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding ReminderSectionTitle}"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#0B2A56, Dark=White}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Store.UpcomingEvents}"
                                             Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="14"
                                            BackgroundColor="{AppThemeBinding Light=#F5FAFF, Dark=#0B2249}"
                                            StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="18" />
                                        </Border.StrokeShape>
                                        <VerticalStackLayout Spacing="5">
                                            <Label Text="{Binding Title}"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#0B2A56, Dark=White}" />
                                            <Label Text="{Binding Description}"
                                                   FontSize="13"
                                                   LineBreakMode="WordWrap"
                                                   TextColor="{AppThemeBinding Light=#5B78A2, Dark=#C8D9F0}" />
                                            <Label Text="{Binding StartsAt, StringFormat='{}{0:dd MMM yyyy, hh:mm tt}'}"
                                                   TextColor="#25A9F5" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="18"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#102542}"
                        Stroke="{AppThemeBinding Light=#D8E5FB, Dark=#1A3B70}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="26" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="10">
                            <Label Text="{Binding AssessmentSectionTitle}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#0B2A56, Dark=White}" />
                            <Button Grid.Column="1"
                                    Text="Refresh"
                                    Padding="16,8"
                                    BackgroundColor="{AppThemeBinding Light=#DCEBFF, Dark=#173E71}"
                                    TextColor="{AppThemeBinding Light=#0B2A56, Dark=White}"
                                    Clicked="OnRefreshClicked" />
                        </Grid>

                        <CollectionView ItemsSource="{Binding Store.PersonalAssessments}"
                                        EmptyView="No assessments are live in this workspace yet.">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="14"
                                            Margin="0,0,0,10"
                                            BackgroundColor="{AppThemeBinding Light=#F5FAFF, Dark=#0B2249}"
                                            StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="20" />
                                        </Border.StrokeShape>
                                        <VerticalStackLayout Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="10">
                                                <VerticalStackLayout Spacing="3">
                                                    <Label Text="{Binding Title}"
                                                           FontSize="18"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light=#0B2A56, Dark=White}" />
                                                    <Label Text="{Binding GroupTitle}"
                                                           FontSize="13"
                                                           TextColor="{AppThemeBinding Light=#5B78A2, Dark=#C8D9F0}" />
                                                </VerticalStackLayout>
                                                <Border Grid.Column="1"
                                                        Padding="12,6"
                                                        BackgroundColor="{AppThemeBinding Light=#DFF3FF, Dark=#173E71}"
                                                        StrokeThickness="0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="16" />
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding Type}"
                                                           FontSize="12"
                                                           TextColor="{AppThemeBinding Light=#0B2A56, Dark=White}" />
                                                </Border>
                                            </Grid>
                                            <Label Text="{Binding Summary}"
                                                   FontSize="13"
                                                   LineBreakMode="WordWrap"
                                                   TextColor="{AppThemeBinding Light=#5B78A2, Dark=#C8D9F0}" />
                                            <Grid ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="10">
                                                <VerticalStackLayout Spacing="3">
                                                    <Label Text="{Binding CourseCode, StringFormat='{}Course: {0}'}"
                                                           FontSize="13"
                                                           TextColor="#25A9F5" />
                                                    <Label Text="{Binding DueAt, StringFormat='{}Due: {0:dd MMM yyyy, hh:mm tt}'}"
                                                           FontSize="13"
                                                           TextColor="{AppThemeBinding Light=#5B78A2, Dark=#C8D9F0}" />
                                                </VerticalStackLayout>
                                                <Button Grid.Column="1"
                                                        Text="Open"
                                                        BackgroundColor="#25A9F5"
                                                        TextColor="White"
                                                        Clicked="OnOpenAssessmentClicked" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <controls:PortalBottomNav Grid.Row="1"
                                  ActiveTab="Events" />
    </Grid>
</ContentPage>
